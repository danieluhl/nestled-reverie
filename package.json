{
  "name": "nestled-reverie",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "deploy": "pnpm build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "typecheck": "wrangler types && tsc --noEmit",
    "db:create": "wrangler d1 create nestled-reverie",
    "db:migrate:local": "wrangler d1 migrations apply nestled-reverie --local",
    "db:migrate": "wrangler d1 migrations apply nestled-reverie --remote",
    "db:seed:local": "wrangler d1 execute nestled-reverie --local --file scripts/seed.sql"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-query-devtools": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.60",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.3",
    "lucide-react": "0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@cloudflare/vite-plugin": "1.60.2",
    "@tailwindcss/typography": "0.5.20",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "1.167.38",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "wrangler": "4.141.0"
  }
}
